# ===== FixPro Backend Environment =====
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fixpro
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173
